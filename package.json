{
  "name": "juristech-solutions",
  "version": "10.5.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "prebuild": "node scripts/generate-sitemap.mjs",
    "generate-sitemap": "node scripts/generate-sitemap.mjs",
    "sitemap:watch": "node scripts/sitemap-scheduler.mjs",
    "clean": "node -e \"import('fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\"",
    "build": "node bump-version.mjs && tsc && vite build && node scripts/prerender-routes.mjs",
    "build:production": "node bump-version.mjs && node scripts/generate-sitemap.mjs && tsc && vite build && node scripts/prerender-routes.mjs && node scripts/ping-indexnow.mjs",
    "daily:update": "node scripts/daily-autonomous-evolution.mjs",
    "evolve:lexicon": "node scripts/evolve-legal-lexicon.mjs",
    "preview": "vite preview",
    "lint": "eslint src",
    "security:truth-scan": "node scripts/security_truth_scan.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7",
    "@types/nodemailer": "^8.0.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "docx": "^9.7.1",
    "html2canvas": "^1.4.1",
    "i18next": "^23.11.5",
    "jspdf": "^2.5.1",
    "lucide-react": "^0.344.0",
    "nodemailer": "^9.0.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^14.1.2",
    "react-router-dom": "^6.22.3",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.4.35",
    "sharp": "^0.35.3",
    "svgo": "^4.0.2",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-compression2": "^2.5.3",
    "vite-plugin-image-optimizer": "^2.0.3"
  }
}
