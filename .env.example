# Paddle Billing Configuration (Sandbox / Live)
# VITE_PADDLE_ENVIRONMENT must be strictly "sandbox" or "live"
VITE_PADDLE_ENVIRONMENT=sandbox

# Sandbox Client-Side Token (must start with test_)
# Obtain from Paddle Sandbox Dashboard > Developer Tools > Authentication
VITE_PADDLE_CLIENT_TOKEN=test_08dad1304849fe550fb9c689a50

# Paddle Product ID
VITE_PADDLE_PRODUCT_ID=pro_01m1f46hy5e68zq68jvm573pzr

# Paddle Price IDs for 3-Tier Pricing (Starter, Pro, Advanced)
VITE_PADDLE_STARTER_PRICE_ID_MONTH=pri_starter_monthly_demo
VITE_PADDLE_STARTER_PRICE_ID_YEAR=pri_starter_yearly_demo

VITE_PADDLE_PRO_PRICE_ID_MONTH=pri_01m0ty6sxjj7w0xpm1r07r50ss
VITE_PADDLE_PRO_PRICE_ID_YEAR=pri_pro_yearly_demo

VITE_PADDLE_ADVANCED_PRICE_ID_MONTH=pri_advanced_monthly_demo
VITE_PADDLE_ADVANCED_PRICE_ID_YEAR=pri_advanced_yearly_demo

# Webhook Secret Key for Server-side Signature Verification (Vercel Server Environment)
PADDLE_WEBHOOK_SECRET=pdl_ntfset_01m1f9vmt0hz5vvqce5pj7pm89_OeiGTt8zzyU3OZ7WBwPvEtDGNrnp5xZA

# Supabase Credentials (Optional for local DB sync)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
