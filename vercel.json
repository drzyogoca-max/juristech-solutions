{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "legalshieldsolution.online"
        }
      ],
      "destination": "https://www.juristech.solutions/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.legalshieldsolution.online"
        }
      ],
      "destination": "https://www.juristech.solutions/:path*",
      "permanent": true
    },
    {
      "source": "/youtube",
      "destination": "/video-hub",
      "permanent": false
    },
    {
      "source": "/youtube-channel",
      "destination": "/video-hub",
      "permanent": false
    },
    {
      "source": "/channel",
      "destination": "/video-hub",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "juristech.solutions"
        }
      ],
      "destination": "https://www.juristech.solutions/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0, s-maxage=0"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0, s-maxage=0"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0, s-maxage=0"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Vary",
          "value": "Accept-Encoding, Accept-Language"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://apis.google.com https://accounts.google.com https://va.vercel-scripts.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https: wss:; frame-src 'self' https://www.youtube.com https://youtube.com https://gumroad.com https://*.gumroad.com; object-src 'none'; base-uri 'self';"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, s-maxage=31536000, immutable"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Timing-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(.*)\\.(webp|avif|png|jpg|jpeg|svg|ico|woff2|woff|ttf|eot|css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, s-maxage=31536000, immutable"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Timing-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/leads/:action*",
      "destination": "/api/leads?action=:action*"
    },
    {
      "source": "/api/partnerships/:action*",
      "destination": "/api/leads?action=:action*"
    },
    {
      "source": "/api/contracts/:action*",
      "destination": "/api/contracts?action=:action*"
    },
    {
      "source": "/api/cron/:task*",
      "destination": "/api/cron?task=:task*"
    },
    {
      "source": "/api/youtube-upload",
      "destination": "/api/video?action=youtube-upload"
    },
    {
      "source": "/api/heygen-webhook",
      "destination": "/api/video?action=heygen-webhook"
    },
    {
      "source": "/api/heygen-generate",
      "destination": "/api/video?action=heygen-generate"
    },
    {
      "source": "/api/video-generate",
      "destination": "/api/video?action=video-generate"
    },
    {
      "source": "/api/send",
      "destination": "/api/send-email"
    },
    {
      "source": "/api/webhooks/:provider*",
      "destination": "/api/webhooks?provider=:provider*"
    },
    {
      "source": "/api/erp/:action*",
      "destination": "/api/webhooks?provider=erp"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron?task=morning-broadcast",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron?task=evening-broadcast",
      "schedule": "0 18 * * *"
    }
  ]
}
