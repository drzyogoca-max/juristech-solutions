# Cloudflare Edge CDN & Security Headers Configuration — JurisTech Solutions
# -----------------------------------------------------------------------------
# Enforces global edge caching for hashed static assets, sub-50ms latency, and Brotli compression.

# 1. Hashed Static Assets (1-Year Immutable Edge Cache)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Access-Control-Allow-Origin: *
  Timing-Allow-Origin: *

# 2. Dynamic Single-Page App Index & API Routing
/*
  Cache-Control: no-cache, no-store, must-revalidate, proxy-revalidate, max-age=0
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)
